{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add -u)",
      "Bash(git add -u *)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add :/)",
      "Bash(git add :/ *)"
    ]
  }
}
